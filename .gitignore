# -------------------------------------------------------
# SharePlate Connect -- .gitignore
# -------------------------------------------------------

# SQLite database files (contain test data; never commit)
*.db
*.sqlite
*.sqlite3
shareplate.db

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment variable files (may contain secrets)
.env
.env.local
.env.*.local

# OS / editor artefacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml

# Pytest / coverage
.pytest_cache/
htmlcov/
.coverage

# Distribution / packaging
dist/
build/
*.egg-info/
